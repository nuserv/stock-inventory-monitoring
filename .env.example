APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
DB_QUEUE_RETRY_AFTER=300
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# Set to true to block all outgoing application email. Omit it to enable email.
MAIL_DISABLE=false

# Optional global SMTP rotation. All slots share MAIL_HOST/PORT/ENCRYPTION.
MAIL_POOL_ENABLED=false
MAIL_POOL_451_COOLDOWN_SECONDS=300
MAIL_POOL_1_USERNAME=null
MAIL_POOL_1_PASSWORD=null
MAIL_POOL_1_FROM_ADDRESS=null
MAIL_POOL_2_USERNAME=null
MAIL_POOL_2_PASSWORD=null
MAIL_POOL_2_FROM_ADDRESS=null
MAIL_POOL_3_USERNAME=null
MAIL_POOL_3_PASSWORD=null
MAIL_POOL_3_FROM_ADDRESS=null
MAIL_POOL_4_USERNAME=null
MAIL_POOL_4_PASSWORD=null
MAIL_POOL_4_FROM_ADDRESS=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
